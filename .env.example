# Copy this file to .env and fill in whichever providers you actually have
# credentials for. Nothing here is required to run the app: with no keys
# set, the Orchestrator falls back to the local Llama agent alone, and
# speech stays local for English while Sinhala/Tamil fall back to local
# Whisper (lower accuracy) with a spoken notice for text to speech. See
# KNOWN_LIMITATIONS.md for what specifically depends on which key.

# Cloud LLM (multi agent collaboration)
# Which provider answers first: "livekit" (LiveKit Inference, uses the LIVEKIT_*
# key and secret below, no other key), "gemini" or "gpt". When it is not set up
# or fails, the local Ollama model answers alone.
CLOUD_LLM_PROVIDER=livekit
LIVEKIT_LLM_MODEL=openai/gpt-4o-mini
LIVEKIT_LLM_TIMEOUT_SECONDS=12
GEMINI_API_KEY=
# Use a "-latest" alias: Google retires pinned names (gemini-2.5-flash now
# returns 404 for newer accounts) but the alias always points at a current
# model. Run GET /health to see the model in use and why it is failing.
GEMINI_MODEL=gemini-flash-lite-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# true adds a separate reasoning call before the reply is composed. Slower
# (the reply cannot start until it finishes), so it is off by default.
CLOUD_REASONING_STAGE=false

# Local LLM fallback (Ollama, no key needed)
LOCAL_LLM_MODEL=llama3.2:latest
# Use 127.0.0.1, not localhost: on Windows localhost adds ~2s to every request (see config.py).
LOCAL_LLM_HOST=http://127.0.0.1:11434

# Cloud speech (STT and TTS): "google" or "azure"
CLOUD_SPEECH_PROVIDER=google
# Path to a Google Cloud service account JSON key with Speech to Text and
# Text to Speech enabled.
GOOGLE_APPLICATION_CREDENTIALS=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Local speech to text fallback
# tiny, base, small, medium, large-v3: bigger is slower but more accurate,
# which matters more for Sinhala/Tamil than for English.
LOCAL_WHISPER_MODEL_SIZE=base
# Words Whisper should expect, so "Mobitel" is not heard as "Mobital".
STT_HOTWORDS=SLT Mobitel
# Noise reduction before transcription: off, because on 144 spoken test clips
# it raised word errors from 3.3% to 11.0% (Whisper copes with noise itself).
STT_DENOISE=false
# Beam search width (higher is slightly more accurate and slower).
STT_BEAM_SIZE=5
# Whisper's speech filter: stops it writing words for noise (with the brand
# hotword on, it wrote "SLT Mobitel" for 30 of 30 noise clips without it).
STT_VAD_FILTER=true
# Larger model for the final transcript when the main one is unsure of it;
# downloaded on first use (about 460 MB for "small"). Leave empty to turn off.
STT_ACCURATE_MODEL=small
# Average log probability below which the larger model rechecks a transcript.
STT_CONFIDENCE_FLOOR=-0.40

# Single app settings
# The address this server is reached at (token issuer and MCP metadata).
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Load Whisper, Ollama, TTS and the knowledge index at startup.
WARM_UP_ON_STARTUP=true

# Database: SQLite file under data/ when empty. PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/voice_assistant
DATABASE_URL=

# Secrets. When empty, a random value is generated once and kept in
# data/secrets.json (fine for a development machine). Set real values in
# any shared or deployed environment. FIELD_ENCRYPTION_KEY is a Fernet key:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JWT_SECRET=
FIELD_ENCRYPTION_KEY=
# true when served over https, so session cookies are never sent in clear.
COOKIE_SECURE=false
USER_SESSION_MINUTES=60
ADMIN_SESSION_MINUTES=60
MCP_TOKEN_MINUTES=15

# Existing user verification: failed PIN attempts before a temporary
# lockout, lockout length, and attempts per minute per client address.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT_PER_MINUTE=10

# First admin for /admin, created at startup only if no admin exists yet.
# Leave ADMIN_PASSWORD empty to skip seeding. At least 10 characters.
# Once any admin exists these values are ignored.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# External chat agents (admin portal). Private and loopback addresses are
# refused unless EXTERNAL_AGENT_ALLOW_PRIVATE=true (local development only).
EXTERNAL_AGENT_ALLOW_PRIVATE=false
EXTERNAL_AGENT_MAX_RESPONSE_BYTES=1000000
EXTERNAL_AGENT_DEFAULT_TIMEOUT=15

# Knowledge base (RAG). Rebuild with: python -m backend.knowledge.build
KNOWLEDGE_ENABLED=true
KNOWLEDGE_DIR=
# Pull first: ollama pull bge-m3
EMBEDDING_MODEL=bge-m3
EMBEDDING_HOST=
RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SCORE=0.53
SCRAPER_DELAY_SECONDS=1.5
SCRAPER_MAX_PAGES=400

# MCP server at /mcp (clients are created in the admin portal)
MCP_ENABLED=true

# Voice transport: livekit (browser microphone in, agent audio out, through a
# LiveKit room; falls back to websocket when LIVEKIT_* below are empty) or
# websocket (original /ws/voice, server side playback).
VOICE_TRANSPORT=livekit
# Run a LiveKit server (livekit-server --dev) or use LiveKit Cloud, then fill in.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL_SECONDS=600
LIVEKIT_AGENT_NAME=voice-assistant

# Avatar: talkinghead (lip synced; run python frontend/avatar/fetch_assets.py
# once to download its model) or legacy (bot3d.js and the flat face).
AVATAR_RENDERER=talkinghead

# voicekit (reusable text to speech, docs/VOICEKIT.md). Comma separated API
# keys for /api/tts/stream and /ws/tts; empty means the API refuses everyone.
VOICEKIT_ENABLED=true
VOICEKIT_API_KEYS=
VOICEKIT_MAX_TEXT_CHARS=2000
VOICEKIT_RATE_LIMIT_PER_MINUTE=30
VOICEKIT_LOCAL_VOICE_DIR=

# MCP hub (this app as a client). The key stays here, never in the code.
MCP_HUB_ENABLED=true
MCP_HUB_URL=https://mcphub.sltdigitallab.lk
MCP_HUB_AUTH_HEADER=X-API-Key
MCP_HUB_API_KEY=
MCP_HUB_TIMEOUT_SECONDS=8
MCP_HUB_RETRIES=2
# Longest a spoken reply waits for hub notes (the hub search takes 3 to 7 s).
MCP_HUB_CONTEXT_BUDGET_SECONDS=1.0
# true also asks the hub's search tool on every reply (slow: 3 to 7 s measured, so off).
MCP_HUB_IN_REPLIES=false
MCP_HUB_BREAKER_SECONDS=300
# Hub tools offered to the assistant (comma separated); empty means every
# tool that takes a single required text argument.
MCP_HUB_TOOLS=
# Hub tool that looks a customer up by landline number; empty uses the local database.
MCP_HUB_CUSTOMER_LOOKUP_TOOL=

# Existing user verification: pin, otp, or pin,otp
AUTH_METHODS=pin
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_RATE_LIMIT_PER_NUMBER_PER_HOUR=5
OTP_RATE_LIMIT_PER_IP_PER_HOUR=20
# console (development only, prints the code), email or sms
OTP_SENDER=console
# hub (MCP hub does lookup and sends the code), local, or auto
OTP_BACKEND=auto
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_AUTH_HEADER=Authorization
SMS_SENDER_ID=SLTMobitel

# Reply model fallback chain: first available tier answers, in this order.
# Names: gemini, livekit, local. Empty keeps the older single provider setting.
LLM_CHAIN=gemini,livekit,local
LLM_BREAKER_SECONDS=300
# Guests may not receive customer service answers (backend/access/policy.json)
ACCESS_CONTROL_ENABLED=true
ACCESS_POLICY_PATH=
# Existing user verification wizard
VERIFY_ENABLED=true
VERIFY_OTP_TTL_SECONDS=120
VERIFY_OTP_RESEND_COOLDOWN_SECONDS=30
VERIFY_OTP_MAX_ATTEMPTS=3
VERIFY_RATE_LIMIT_PER_IP_PER_HOUR=20
VERIFY_RATE_LIMIT_PER_PHONE_PER_HOUR=6
VERIFY_TICKET_MINUTES=10
NAME_MATCH_REQUIRED=true
# Empty means the same as OTP_SENDER. console is for development only.
VERIFY_OTP_SENDER=
